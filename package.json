{
	"name": "centeroftheinternet",
	"private": true,
	"version": "0.0.1",
	"description": "Custodial rebuild of the 2008 exactcenteroftheinternet.com and its joke sibling, approximatecenteroftheinternet.com. Tables, not CSS.",
	"keywords": [
		"exactcenteroftheinternet",
		"approximatecenteroftheinternet",
		"sveltekit",
		"static-site",
		"wayback-machine",
		"web-archaeology",
		"internet-history",
		"joke"
	],
	"license": "EUPL-1.2",
	"homepage": "https://exactcenteroftheinternet.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sunsided/exactcenteroftheinternet.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:approximate": "PUBLIC_SITE=approximate vite dev",
		"build": "yarn build:exact && yarn build:approximate",
		"build:exact": "PUBLIC_SITE=exact vite build && node scripts/postbuild.js build/exact --quirks",
		"build:approximate": "PUBLIC_SITE=approximate vite build && node scripts/postbuild.js build/approximate",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"deploy": "./scripts/deploy.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
